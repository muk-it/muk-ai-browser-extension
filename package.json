{
    "name": "muk-ai-browser-extension",
    "version": "1.0.1",
    "description": "Chrome extension for the MuK AI browser agent: page actions for the muk_ai_browser Odoo app, with its chat in the side panel.",
    "license": "Apache-2.0",
    "author": "MuK IT",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "wxt",
        "build": "wxt build",
        "zip": "wxt zip",
        "zip:store": "wxt zip --mode store",
        "postinstall": "wxt prepare",
        "test": "vitest run",
        "e2e": "playwright test",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "wxt": "^0.20.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.18.0",
        "@playwright/test": "^1.49.0",
        "@types/chrome": "^0.0.287",
        "@types/node": "^22.10.0",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "@wxt-dev/module-react": "^1.1.3",
        "eslint": "^9.18.0",
        "eslint-plugin-jsdoc": "^50.6.0",
        "globals": "^15.14.0",
        "jsdom": "^25.0.1",
        "prettier": "^3.4.2",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.20.0",
        "vitest": "^2.1.8"
    }
}
