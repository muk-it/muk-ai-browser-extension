{
    "extends": "./.wxt/tsconfig.json",
    "compilerOptions": {
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "jsx": "react-jsx",
        "types": ["chrome", "node"]
    },
    "include": [
        "lib/**/*",
        "entrypoints/**/*",
        "tests/**/*",
        "e2e/**/*",
        "*.ts",
        ".wxt/**/*.d.ts"
    ]
}
